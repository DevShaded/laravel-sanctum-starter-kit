includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 10
    paths:
        - app
        - bootstrap/app.php
        - bootstrap/providers.php
        - config
        - database
        - routes
        - tests
    tmpDir: storage/framework/cache/phpstan
    reportUnmatchedIgnoredErrors: true
