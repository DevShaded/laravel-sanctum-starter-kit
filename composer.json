{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "devshaded/laravel-sanctum-starter-kit",
    "type": "project",
    "description": "An API-only Laravel starter kit with Sanctum bearer tokens and Docker development.",
    "keywords": [
        "laravel",
        "sanctum",
        "api",
        "starter-kit",
        "sail"
    ],
    "homepage": "https://github.com/DevShaded/laravel-sanctum-starter-kit",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/DevShaded/laravel-sanctum-starter-kit/issues",
        "source": "https://github.com/DevShaded/laravel-sanctum-starter-kit"
    },
    "require": {
        "php": "^8.5",
        "dedoc/scramble": "^0.13.48",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.69",
        "laravel/vet": "^0.2.1",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^13.4.2",
        "rector/rector": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install --no-interaction",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan config:clear --no-interaction",
            "@php artisan app:ensure-key --no-interaction",
            "@php artisan migrate --no-interaction"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan queue:work --tries=3"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan app:ensure-key --no-interaction --ansi",
            "@php artisan migrate --graceful --no-interaction --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "analyse": "phpstan analyse --memory-limit=1G",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@format:check",
            "@analyse",
            "@rector:check",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "laravel/vet": true
        },
        "policy": {
            "abandoned": {
                "audit": "fail",
                "ignore": {
                    "symplify/rule-doc-generator-contracts": "Development-only transitive dependency of driftingly/rector-laravel. Retain Laravel Rector rules until upstream removes it; this exception does not ignore security advisories."
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
